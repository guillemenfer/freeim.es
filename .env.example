# Copiá este archivo a ".env" y completá tus datos reales. No subas ".env" a ningún repo.

# --- Email (Gmail) ---
# SMTP_USER: tu dirección de Gmail
# SMTP_PASSWORD: una "contraseña de aplicación" de 16 caracteres (NO tu contraseña normal),
#   se genera en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contraseña_de_aplicacion_16_caracteres
EMAIL_TO=businessfreim@gmail.com

# --- Modelo ---
# Ligas de Codere a seguir: "nodeId:Nombre" separados por coma. Para otra liga, hay
# que ubicar su NodeId navegando la web de Codere e inspeccionando la llamada a
# NavigationService/Event/GetEvents?parentId=... (ver README).
CODERE_LEAGUE_NODE_IDS=3253425078:Liga Profesional,3788530433:Eliteserien,2995719538:Allsvenskan,2995723493:Veikkausliiga
# Nombre de liga (igual que arriba) -> proveedor de estadísticas ("espn" o "flashscore").
# Cada liga de arriba necesita su entrada acá (ver README).
STATS_PROVIDERS=Liga Profesional:espn,Eliteserien:espn,Allsvenskan:espn,Veikkausliiga:flashscore
# Nombre de liga -> slug de ESPN, para las que usan proveedor "espn".
ESPN_LEAGUE_SLUGS=Liga Profesional:arg.1,Eliteserien:nor.1,Allsvenskan:swe.1
# Nombre de liga -> "tournamentId:tournamentStageId" de Flashscore, para las que usan
# proveedor "flashscore".
FLASHSCORE_TOURNAMENTS=Veikkausliiga:jg5JgLZo:h6IND07k
# Diferencia mínima (en probabilidad) entre el modelo y la cuota para avisar. 0.05 = 5 puntos porcentuales
EDGE_THRESHOLD=0.05
# Edges por encima de esto se descartan por ser casi siempre error de modelo
MAX_TRUSTED_EDGE=0.20
# Probabilidad del modelo a partir de la cual algo se lista como "evento probable"
HIGH_PROB_THRESHOLD=0.65
# Cantidad de partidos recientes de cada equipo usados para estimar su forma
FORM_MATCHES=8
# Córners promedio "típico" de un equipo por partido (ancla para suavizar promedios)
LEAGUE_AVG_CORNERS=5.0
# Similitud mínima (0-1) al buscar el nombre del equipo en ESPN
NAME_MATCH_THRESHOLD=0.6

# --- Ejecución periódica (modo --loop) ---
CHECK_INTERVAL_MINUTES=30

# --- Red ---
REQUEST_TIMEOUT=10
REQUEST_DELAY_SECONDS=0.8
